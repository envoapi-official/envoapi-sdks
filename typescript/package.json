{
  "name": "envoapi",
  "version": "0.1.3",
  "license": "MIT",
  "description": "The EnvoAPI TypeScript and JavaScript SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envoapi-official/envoapi-sdks.git",
    "directory": "typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
